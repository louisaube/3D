#!/usr/bin/env python3
"""PyCAM3D - Direct executable entry point."""
import sys
import os

# Add src to path if running from source directory
src_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src')
if os.path.exists(src_path):
    sys.path.insert(0, src_path)

from pycam3d.cli import main

if __name__ == '__main__':
    main()
